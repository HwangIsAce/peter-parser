# =============================================================================
# peter-parser Environment Variables
# Copy to .env and fill in your values: cp env.example .env
# =============================================================================

# --- Upstage (required for PDF parsing) ---
UPSTAGE_API_KEY=your_upstage_api_key

# --- LLM/VLM (API Gateway → RunPod) ---
# 기본 URL: http://<서버주소>:8000, API 버전: /v1
# POST /v1/chat/completions - 모델명으로 LLM/VLM 라우팅 (qwen-llm-* → LLM Pod, qwen-vlm-* → VLM Pod)
# OPENAI_BASE_URL 비우면 OpenAI 기본 URL(api.openai.com) 사용
OPENAI_API_KEY=
OPENAI_BASE_URL=http://194.68.245.144:22110/v1
# LLM과 VLM이 같은 엔드포인트를 쓰면 비워두기 (모델명으로 라우팅)
OPENAI_VISION_BASE_URL=
OPENAI_MODEL=qwen-llm-7b
OPENAI_VISION_MODEL=qwen-vlm-7b
# RunPod VLM용: "runpod" (content 문자열 + image_base64)
VLM_REQUEST_FORMAT=runpod

# --- Optional ---
# DEFAULT_CHUNK_UNIT=page
# CHUNK_MAX_CONTENT_LENGTH=10000
# ROUTER_CONTENT_MAX_CHARS=6000
# VLM routing (sample pages from PDF): ROUTER_VLM_MAX_PAGES=4, ROUTER_VLM_PAGE_SAMPLE=uniform
# ROUTER_FEWSHOT_DIR=  (default: assets/router_fewshot; run scripts/generate_router_fewshot.py to populate)
# REDIS_URL=redis://localhost:6379/0

# --- VLM Chunker optimization batch (Phase 4) ---
# VLM_OPT_BATCH_SIZE=10
# VLM_OPT_OPENAI_MODEL=gpt-4
# Trigger batch via cron: rq enqueue peter_parser.api.tasks.run_vlm_chunk_optimization_batch
# Or: uv run python scripts/enqueue_vlm_optimization_batch.py
